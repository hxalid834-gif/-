{
 "name": "hospital-app",
 "version": "1.0.0",
 "description": "Hospital app (React + Tailwind)",
 "author": "Hospital",
 "private": true,
 "main": "main.js",
 "scripts": {
  "dev": "vite",
  "build:android": "vite build --mode android",
  "build:ios": "vite build --mode ios",
  "build:desktop": "vite build --mode desktop",
  "start:desktop": "npm run build:desktop && electron .",
  "dist:win": "npm run build:desktop && electron-builder --win"
 },
 "devDependencies": {
  "@capacitor/android": "^6.1.2",
  "@capacitor/cli": "^6.1.2",
  "@capacitor/core": "^6.1.2",
  "@capacitor/ios": "^6.1.2",
  "@vitejs/plugin-react": "^4.3.1",
  "autoprefixer": "^10.4.20",
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3",
  "postcss": "^8.4.41",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "tailwindcss": "^3.4.10",
  "vite": "^5.4.0"
 },
 "build": {
  "appId": "com.hospital.app",
  "productName": "Hospital",
  "files": [
   "main.js",
   "dist-desktop/**/*"
  ],
  "win": {
   "target": [
    "nsis",
    "portable"
   ]
  },
  "directories": {
   "output": "release"
  }
 }
}